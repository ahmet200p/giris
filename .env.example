# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# SQLite:
DATABASE_URL="file:./dev.db"
# PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/giris_db?schema=public"

# JWT Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*

